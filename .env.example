# MTK NEWS Environment Configuration Template

# Database:
# Local SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Supabase, Neon, AWS RDS, Docker, etc.):
# DATABASE_URL="postgresql://username:password@hostname:5432/mtk_news?schema=public"

# Authentication:
JWT_SECRET="replace-with-a-random-32-character-secret-key"
JWT_EXPIRES_IN="7d"

# Site URLs:
NEXT_PUBLIC_SITE_URL="https://toancanh24h.io.vn"
NEXT_PUBLIC_SITE_NAME="NHỊP SỐNG 247"

# Cron / Background Worker Secret:
CRON_SECRET="replace-with-random-secret-token"

# AI Editorial Assistant (Optional):
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Media Storage (Optional Cloudinary - defaults to local /public/uploads/):
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
